+        if (target == null || chatAdapter == null) {
+            return;
+        }
+        for (int i = 0; i < messages.size(); i++) {
+            final MessageObject m = messages.get(i);
+            if (m.getId() == target.getId() && m.getDialogId() == target.getDialogId()) {
+                m.forceUpdate = true;
+                chatAdapter.notifyItemChanged(chatAdapter.messagesStartRow + i);
+                break;
+            }
+        }
+    }
