+        threadsMode = true;
+        threadsModeMessage = messageObject;
+        showFieldPanelForReply(messageObject);
+        if (chatActivityEnterView != null) {
+            chatActivityEnterView.openKeyboard();
+        }
+    }
+
+    private boolean threadsInterceptSend(CharSequence message) {
+        // THREADS: the mode belongs to the replied message, not to the panel shown (reply or link preview).
+        if (!threadsMode || replyingMessageObject == null || threadsModeMessage == null || threadsModeMessage.getId() != replyingMessageObject.getId()) {
+            return false;
+        }
+        final String text = message == null ? "" : message.toString().trim();
+        if (TextUtils.isEmpty(text)) {
+            return false;
+        }
+        final MessageObject parent = replyingMessageObject;
+        ThreadsStore.addReply(currentAccount, dialog_id, parent.getId(), text);
+        threadsMode = false;
+        threadsModeMessage = null;
+        showFieldPanel(false, null, null, null, null, true, 0, null, true, 0, true);
+        threadsOpen(parent);
+        return true;
+    }
+
+    // THREADS: the chat's list of threads, with the parent messages already loaded here (others are read there)
+    private void threadsOpenList() {
+        final ArrayList<Integer> ids = ThreadsStore.getThreadIds(currentAccount, dialog_id);
+        final ArrayList<MessageObject> parents = new ArrayList<>();
+        for (int i = 0; i < messages.size(); i++) {
+            final MessageObject m = messages.get(i);
+            if (m != null && m.getDialogId() == dialog_id && ids.contains(m.getId())) {
+                parents.add(m);
+            }
+        }
+        final CharSequence name = currentChat != null ? currentChat.title : currentUser != null ? UserObject.getUserName(currentUser) : null;
+        presentFragment(new ThreadsListActivity(dialog_id, name, parents));
+    }
