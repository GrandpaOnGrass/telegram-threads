+    private void threadsShowLayoutMode(ChatReplyContainer.Layout layout, boolean on) {
+        final SimpleTextView threadTitle = threadsTitleView(layout);
+        threadTitle.setTextColor(ThreadsConfig.THREAD_ACCENT_COLOR); // THREADS (stage 9c): one value for Day and Night
+        layout.name.setAlpha(on ? 0f : 1f);
+        threadTitle.setAlpha(on ? 1f : 0f);
+        threadTitle.setVisibility(on ? View.VISIBLE : View.GONE);
+        layout.icon.setAlpha(1f);
+        layout.icon.setVisibility(on ? View.INVISIBLE : View.VISIBLE);
+    }
+
+    // THREADS (stage 9a): the "Thread on" title of a reply layout, made once per layout: Telegram's title (14dp bold,
+    // 18dp high) with the same position, which it keeps following (it moves right when the reply shows a picture).
+    private SimpleTextView threadsTitleView(ChatReplyContainer.Layout layout) {
+        final View existing = layout.findViewWithTag("threads_title");
+        if (existing instanceof SimpleTextView) {
+            return (SimpleTextView) existing;
+        }
+        final SimpleTextView threadTitle = new SimpleTextView(layout.getContext());
+        threadTitle.setTag("threads_title");
+        threadTitle.setTextSize(14);
+        threadTitle.setTypeface(AndroidUtilities.bold());
+        threadTitle.setAlpha(0f);
+        threadTitle.setVisibility(View.GONE);
+        final FrameLayout.LayoutParams nameParams = (FrameLayout.LayoutParams) layout.name.getLayoutParams();
+        final FrameLayout.LayoutParams titleParams = new FrameLayout.LayoutParams(nameParams);
+        layout.addView(threadTitle, titleParams);
+        layout.name.addOnLayoutChangeListener((v, l, t, r, b, ol, ot, or, ob) -> {
+            final FrameLayout.LayoutParams np = (FrameLayout.LayoutParams) v.getLayoutParams();
+            final FrameLayout.LayoutParams tp = (FrameLayout.LayoutParams) threadTitle.getLayoutParams();
+            if (tp.leftMargin != np.leftMargin || tp.topMargin != np.topMargin || tp.rightMargin != np.rightMargin) {
+                tp.leftMargin = np.leftMargin;
+                tp.topMargin = np.topMargin;
+                tp.rightMargin = np.rightMargin;
+                // measured now, so the parent lays it out at the new size in this same pass (it comes after the name)
+                threadTitle.measure(View.MeasureSpec.makeMeasureSpec(r - l, View.MeasureSpec.EXACTLY), View.MeasureSpec.makeMeasureSpec(b - t, View.MeasureSpec.EXACTLY));
+            }
+        });
+        return threadTitle;
+    }
