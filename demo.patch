+    public static void ensureFakeUsers(int account) {
+        if (!BuildVars.DEBUG_VERSION) {
+            return;
+        }
+        final MessagesController controller = MessagesController.getInstance(account);
+        for (int i = 0; i < FAKE_NAMES.length; i++) {
+            final long id = FAKE_ID_BASE + i;
+            if (controller.getUser(id) != null) {
+                continue;
+            }
+            final TLRPC.TL_user user = new TLRPC.TL_user();
+            user.id = id;
