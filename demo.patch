+public final class ThreadsDemo {
+
+    // THREADS DEBUG: the demo script. Edit freely.
+    // sender: 0 = you (the current user), 1..3 = the three demo participants.
+    // minute: when it was written, in minutes after the first line (the last line is "now").
+    public static final Object[][] SCRIPT = {
+        // sender, minute, text
+        {1, 0, "Which Android version?"},
+        {2, 3, "Pixel 8, Android 15"},
+        {3, 6, "Checking the logs"},
+        {1, 18, "Reproduced. It's the retry on the payment screen"},
+        {3, 41, "Fix is in, can you re-test?"},
+        {0, 47, "Works now, thanks"},
+    };
+
+    // THREADS DEBUG: placeholder participants used when "fake names" is on (letter avatars, no real people).
+    // The demo uses the first three; "add many participants" (stage 6) uses all eight.
+    public static final String[] FAKE_NAMES = {"Max", "Anna", "Oleg", "Kate", "Ivan", "Nina", "Leo", "Mia"};
+
+    // THREADS DEBUG (temporary, stage 6): one short reply from each of 8 different people, to test the
+    // "Members" row and the members list.
+    public static final String[] MANY_SCRIPT = {
