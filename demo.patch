+    }
+
+    // THREADS DEBUG: the first count participants (count <= FAKE_NAMES.length), null if there aren't enough people.
+    public static long[] participants(int account, int count) {
+        final long[] ids = new long[count];
+        if (useFakeNames()) {
+            ensureFakeUsers(account);
+            for (int i = 0; i < ids.length; i++) {
+                ids[i] = FAKE_ID_BASE + i;
+            }
+            return ids;
+        }
+        final long self = UserConfig.getInstance(account).getClientUserId();
+        final MessagesController controller = MessagesController.getInstance(account);
+        final ArrayList<TLRPC.Dialog> dialogs = controller.getAllDialogs();
+        int found = 0;
+        for (int d = 0; d < dialogs.size() && found < ids.length; d++) {
+            final long did = dialogs.get(d).id;
+            if (did <= 0 || did == self) {
+                continue;
+            }
+            final TLRPC.User user = controller.getUser(did);
+            if (user == null || user.bot || UserObject.isDeleted(user) || UserObject.isReplyUser(user) || UserObject.isService(user.id)) {
+                continue;
+            }
+            ids[found++] = did;
+        }
+        return found == ids.length ? ids : null;
+    }
