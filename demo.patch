+
+    // THREADS (stage 11): "days" days before today (the real calendar date) at "HH:mm" local time
+    private static int dateAt(int days, String clock) {
+        final Calendar calendar = Calendar.getInstance();
+        calendar.add(Calendar.DAY_OF_YEAR, -days);
+        final String[] hm = clock.split(":");
+        calendar.set(Calendar.HOUR_OF_DAY, Integer.parseInt(hm[0]));
+        calendar.set(Calendar.MINUTE, Integer.parseInt(hm[1]));
+        calendar.set(Calendar.SECOND, 0);
+        calendar.set(Calendar.MILLISECOND, 0);
+        return (int) (calendar.getTimeInMillis() / 1000);
+    }
+
+    // THREADS (stage 11): the time for a message sent live in the demo chat: the demo's "now" plus the time since
+    // "Load demo chat". The real time for every other dialog (and when the demo is not loaded).
+    public static int now(long dialogId) {
+        if (isDemoDialog(dialogId)) {
+            return anchorDate + (int) ((android.os.SystemClock.elapsedRealtime() - loadedAtElapsed) / 1000);
+        }
+        return (int) (System.currentTimeMillis() / 1000);
+    }
+
+    // THREADS (stage 10): the files and links as messages from the server would carry them: a document with its file
+    // name attribute, or a web page with its title and description (no photo) and the URL as the message text.
+    private static void buildSharedMedia(int account, long self, int now) {
+        sharedFiles.clear();
+        sharedLinks.clear();
+        int id = FIRST_MESSAGE_ID + 1_000_000;
+        for (int i = 0; i < FILES.length; i++) {
+            final Object[] line = FILES[i];
+            final TLRPC.TL_message message = sharedMessage(self, (Integer) line[0], dateAt((Integer) line[1], (String) line[2], now), id++);
+            final TLRPC.TL_document document = new TLRPC.TL_document();
+            document.id = DOCUMENT_ID_BASE + i;
+            document.access_hash = document.id;
+            document.file_reference = new byte[0];
+            document.date = message.date;
+            document.mime_type = (String) line[4];
+            document.size = (Integer) line[5];
+            document.dc_id = 2;
+            final TLRPC.TL_documentAttributeFilename name = new TLRPC.TL_documentAttributeFilename();
+            name.file_name = (String) line[3];
+            document.attributes.add(name);
+            final TLRPC.TL_messageMediaDocument media = new TLRPC.TL_messageMediaDocument();
+            media.document = document;
+            media.flags |= 1;
+            message.media = media;
+            message.message = "";
+            sharedFiles.add(message);
+        }
+        for (Object[] line : LINKS) {
+            final TLRPC.TL_message message = sharedMessage(self, (Integer) line[0], dateAt((Integer) line[1], (String) line[2], now), id++);
+            final String url = (String) line[3];
+            message.message = url;
+            final TLRPC.TL_messageEntityUrl entity = new TLRPC.TL_messageEntityUrl();
+            entity.offset = 0;
+            entity.length = url.length();
+            message.entities.add(entity);
+            final TLRPC.TL_webPage page = new TLRPC.TL_webPage();
+            page.url = url;
+            page.display_url = url;
+            page.title = (String) line[4];
+            page.description = (String) line[5];
+            page.site_name = android.net.Uri.parse(url).getHost();
+            final TLRPC.TL_messageMediaWebPage media = new TLRPC.TL_messageMediaWebPage();
+            media.webpage = page;
+            message.media = media;
+            sharedLinks.add(message);
+        }
+    }
+
+    private static TLRPC.TL_message sharedMessage(long self, int sender, int date, int id) {
+        final TLRPC.TL_message message = new TLRPC.TL_message();
+        message.id = id;
+        message.peer_id = new TLRPC.TL_peerChat();
+        message.peer_id.chat_id = CHAT_ID;
+        message.dialog_id = DIALOG_ID;
+        message.from_id = new TLRPC.TL_peerUser();
+        message.from_id.user_id = sender == 0 ? self : userId(sender - 1);
+        message.flags |= TLRPC.MESSAGE_FLAG_HAS_FROM_ID;
+        message.out = sender == 0;
+        message.date = date;
+        return message;
+    }
+
+    // THREADS (stage 10): the shared files / links of a demo dialog, newest first, for the thread info screen.
+    // Empty for every other dialog.
+    public static ArrayList<MessageObject> getSharedFiles(int account, long dialogId) {
+        return sharedObjects(account, dialogId, sharedFiles);
+    }
+
+    public static ArrayList<MessageObject> getSharedLinks(int account, long dialogId) {
+        return sharedObjects(account, dialogId, sharedLinks);
+    }
+
+    private static ArrayList<MessageObject> sharedObjects(int account, long dialogId, ArrayList<TLRPC.Message> source) {
+        final ArrayList<MessageObject> objects = new ArrayList<>();
+        if (loadedAccount != account || dialogId != DIALOG_ID) {
+            return objects;
+        }
+        for (TLRPC.Message message : source) {
+            objects.add(new MessageObject(account, message, false, false));
+        }
+        return objects;
+    }
+
+    public static void remove(int account) {
+        if (loadedAccount != account) {
+            return;
+        }
+        final MessagesController controller = MessagesController.getInstance(account);
+        if (dialog != null) {
+            controller.dialogs_dict.remove(DIALOG_ID);
+            controller.dialogMessage.remove(DIALOG_ID);
+            controller.getAllDialogs().remove(dialog);
+        }
+        deleteAvatarFiles(account);
+        ThreadsStore.clearDemo(); // stage 7b: its thread replies too
+        dialog = null;
+        messages.clear();
+        sharedFiles.clear(); // THREADS (stage 10)
+        sharedLinks.clear(); // THREADS (stage 10)
+        anchorDate = 0; // THREADS (stage 11)
+        loadedAtElapsed = 0;
+        loadedAccount = -1;
+        controller.sortDialogs(null);
+        NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.dialogsNeedReload);
+    }
+
+    // ---- Hooks ----
+
+    // THREADS: MessagesController.sortDialogs(): a refresh from the server can rebuild the list without the demo chat
+    public static void ensureInDialogs(MessagesController controller, int account) {
+        if (dialog == null || loadedAccount != account) {
+            return;
+        }
+        if (controller.dialogs_dict.get(DIALOG_ID) == null || !controller.getAllDialogs().contains(dialog)) {
+            addToDialogs(controller, account);
+        }
+    }
+
+    private static void addToDialogs(MessagesController controller, int account) {
+        controller.dialogs_dict.put(DIALOG_ID, dialog);
+        final ArrayList<MessageObject> lastMessage = new ArrayList<>();
+        lastMessage.add(new MessageObject(account, messages.get(messages.size() - 1), false, false));
+        controller.dialogMessage.put(DIALOG_ID, lastMessage);
+        if (!controller.getAllDialogs().contains(dialog)) {
+            controller.getAllDialogs().add(dialog);
+        }
+    }
+
+    // THREADS: MessagesController.loadMessages(): the scripted messages, as the end of the history both ways.
+    // Only the normal mode on the first load gets them; other modes (scheduled...) and later pages are empty.
+    public static void deliverMessages(int account, long dialogId, int count, int max_id, int offset_date, int classGuid, int load_type, int mode, int loadIndex) {
+        final ArrayList<MessageObject> objects = new ArrayList<>();
+        final boolean firstPage = max_id == 0 && offset_date == 0 || load_type == 2 || load_type == 3;
+        if (mode == 0 && firstPage) {
+            // newest first, as from the server
+            for (int i = messages.size() - 1; i >= 0; i--) {
+                objects.add(new MessageObject(account, messages.get(i), true, false));
+            }
+        }
+        final int lastId = messages.isEmpty() ? 0 : messages.get(messages.size() - 1).id;
+        AndroidUtilities.runOnUIThread(() -> NotificationCenter.getInstance(account).postNotificationName(
+            NotificationCenter.messagesDidLoad, dialogId, count, objects, false, 0, lastId, 0, 0, load_type, true, classGuid, loadIndex, max_id, 0, mode));
+    }
+
+    // THREADS: MessagesController.loadFullChat(): the members from memory, nothing from the server
+    public static void deliverFullChat(int account) {
+        final TLRPC.ChatFull full = MessagesController.getInstance(account).getChatFull(CHAT_ID);
+        if (full == null) {
+            return;
+        }
+        AndroidUtilities.runOnUIThread(() -> NotificationCenter.getInstance(account).postNotificationName(
+            NotificationCenter.chatInfoDidLoad, full, 0, false, false));
+    }
+
+    // THREADS: ConnectionsManager: drops every request that mentions a demo id (chat, people, photos), so nothing about
+    // the demo chat reaches Telegram's servers. Only while the demo chat is loaded.
+    public static boolean blocksRequest(TLObject request) {
+        final long[] ids = blockedIds;
+        if (loadedAccount == -1 || ids.length == 0 || request == null) {
+            return false;
+        }
+        try {
+            final SerializedData data = new SerializedData(request.getObjectSize());
+            request.serializeToStream(data);
+            final byte[] bytes = data.toByteArray();
+            data.cleanup();
+            for (long id : ids) {
+                if (contains(bytes, id)) {
+                    FileLog.d("THREADS DEBUG: dropped a request about the demo chat: " + request);
+                    return true;
+                }
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+        return false;
+    }
+
+    private static boolean contains(byte[] bytes, long value) {
+        outer:
+        for (int i = 0; i + 8 <= bytes.length; i++) {
+            for (int b = 0; b < 8; b++) {
+                if (bytes[i + b] != (byte) (value >>> (8 * b))) {
+                    continue outer;
+                }
+            }
+            return true;
+        }
+        return false;
+    }
+
+    // ---- Helpers ----
+
+    private static boolean hasPhoto(int index) {
+        return !ThreadsDemo.useFakeNames() && PHOTOS[index] != null;
+    }
+
+    // As TL_userProfilePhoto.readParams() fills it: the small and big locations are (-photo_id, 'a' / 'c').
+    private static TLRPC.TL_userProfilePhoto profilePhoto(long photoId) {
+        final TLRPC.TL_userProfilePhoto photo = new TLRPC.TL_userProfilePhoto();
+        photo.photo_id = photoId;
+        photo.dc_id = 2;
+        photo.photo_small = fileLocation(photoId, 'a');
+        photo.photo_big = fileLocation(photoId, 'c');
+        return photo;
+    }
+
+    private static TLRPC.TL_fileLocationToBeDeprecated fileLocation(long photoId, char size) {
+        final TLRPC.TL_fileLocationToBeDeprecated location = new TLRPC.TL_fileLocationToBeDeprecated();
+        location.volume_id = -photoId;
+        location.local_id = size;
+        location.dc_id = 2;
+        return location;
+    }
+
+    private static TLRPC.TL_chatFull createChatFull(long self, int date) {
+        final TLRPC.TL_chatFull full = new TLRPC.TL_chatFull();
+        full.id = CHAT_ID;
+        full.about = "";
+        full.chat_photo = new TLRPC.TL_photoEmpty();
+        full.notify_settings = new TLRPC.TL_peerNotifySettings();
+        final TLRPC.TL_chatParticipants participants = new TLRPC.TL_chatParticipants();
+        participants.chat_id = CHAT_ID;
+        participants.version = 1;
+        final TLRPC.TL_chatParticipant me = new TLRPC.TL_chatParticipant();
+        me.user_id = self;
+        me.inviter_id = userId(0);
+        me.date = date;
+        participants.participants.add(me);
+        for (int i = 0; i < NAMES.length; i++) {
+            final TLRPC.TL_chatParticipant p = new TLRPC.TL_chatParticipant();
+            p.user_id = userId(i);
+            p.inviter_id = userId(0);
+            p.date = date;
+            participants.participants.add(p);
+        }
+        full.participants = participants;
+        return full;
+    }
+
+    // ---- Avatars: the photos, put where Telegram keeps downloaded avatars, so no download is needed. ----
+    // The small (160px, 'a') and big (640px, 'c') sizes of a profile photo, as the server sends them.
+
+    private static ArrayList<File> avatarFiles(long photoId) {
+        final ArrayList<File> files = new ArrayList<>();
+        for (char size : new char[]{'a', 'c'}) {
+            final String name = FileLoader.getAttachFileName(fileLocation(photoId, size));
+            // ImageLoader looks in the cache folder (cacheType 1) or the images folder: put it in both
+            files.add(new File(FileLoader.getDirectory(FileLoader.MEDIA_DIR_CACHE), name));
+            files.add(new File(FileLoader.getDirectory(FileLoader.MEDIA_DIR_IMAGE), name));
+        }
+        return files;
+    }
+
+    private static void writeAvatarFiles(int account) {
+        for (int i = 0; i < NAMES.length; i++) {
+            if (!hasPhoto(i)) {
+                continue;
+            }
+            Bitmap source = null;
+            try (InputStream in = ApplicationLoader.applicationContext.getAssets().open("threads_demo/" + PHOTOS[i])) {
+                source = BitmapFactory.decodeStream(in);
+            } catch (Exception e) {
+                FileLog.e(e); // not in this build (release builds have no demo photos): letter avatar
+            }
+            if (source == null) {
+                continue;
+            }
+            final ArrayList<File> files = avatarFiles(PHOTO_ID_BASE + 1 + i);
+            for (int f = 0; f < files.size(); f++) {
+                final File file = files.get(f);
+                // files come as (small cache, small images, big cache, big images)
+                final int size = f < 2 ? 160 : 640;
+                try {
+                    if (file.getParentFile() != null && !file.getParentFile().exists()) {
+                        continue;
+                    }
+                    final Bitmap scaled = Bitmap.createScaledBitmap(source, size, size, true);
+                    try (FileOutputStream out = new FileOutputStream(file)) {
+                        scaled.compress(Bitmap.CompressFormat.JPEG, 90, out);
+                    }
+                    if (scaled != source) {
+                        scaled.recycle();
+                    }
+                } catch (Exception e) {
+                    FileLog.e(e);
+                }
+            }
+            source.recycle();
+        }
+    }
+
+    private static void deleteAvatarFiles(int account) {
+        final ArrayList<File> files = new ArrayList<>();
+        files.addAll(avatarFiles(PHOTO_ID_BASE)); // the 7a group placeholder, if an older build left it
+        for (int i = 0; i < NAMES.length; i++) {
+            files.addAll(avatarFiles(PHOTO_ID_BASE + 1 + i));
+        }
+        for (File file : files) {
+            try {
+                if (file.exists()) {
+                    file.delete();
+                }
+            } catch (Exception e) {
+                FileLog.e(e);
+            }
+        }
+    }
+}
