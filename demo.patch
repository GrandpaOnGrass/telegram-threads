+    // THREADS DEBUG (temporary, stage 6): adds one reply from each of 8 people (MANY_SCRIPT), after the existing ones.
+    // Marked as demo replies, so "remove test participants" removes them. Returns false if there aren't enough people.
+    public static boolean addMany(int account, long dialogId, int parentMessageId) {
+        final long[] people = participants(account, MANY_SCRIPT.length);
+        if (people == null) {
+            return false;
+        }
+        final int now = ThreadsDemoChat.now(dialogId); // THREADS (stage 11): the demo chat's own clock there
+        for (int i = 0; i < people.length; i++) {
+            ThreadsStore.addDemoReply(account, dialogId, parentMessageId, MANY_SCRIPT[i], people[i], now - (people.length - 1 - i) * 60);
+        }
+        return true;
+    }
+
+    // THREADS DEBUG: replaces any earlier demo/test replies with the script. Returns false if there aren't enough people.
+    public static boolean load(int account, long dialogId, int parentMessageId) {
+        final long[] people = participants(account);
+        if (people == null) {
+            return false;
+        }
+        final long self = UserConfig.getInstance(account).getClientUserId();
+        ThreadsStore.deleteTestReplies(account, dialogId, parentMessageId, self);
+        final int lastMinute = (Integer) SCRIPT[SCRIPT.length - 1][1];
+        final int start = ThreadsDemoChat.now(dialogId) - lastMinute * 60; // THREADS (stage 11)
+        for (Object[] line : SCRIPT) {
+            final int sender = (Integer) line[0];
+            final int minute = (Integer) line[1];
+            final long senderId = sender == 0 ? self : people[sender - 1];
+            ThreadsStore.addDemoReply(account, dialogId, parentMessageId, (String) line[2], senderId, start + minute * 60);
+        }
+        return true;
+    }
+}
