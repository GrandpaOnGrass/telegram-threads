+package org.telegram.ui.threads;
+
+import android.app.Activity;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.Build;
+import android.text.Editable;
+import android.view.View;
+import android.view.inputmethod.InputMethodManager;
+import android.widget.EditText;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.BuildVars;
+import org.telegram.messenger.FileLog;
+import org.telegram.ui.LaunchActivity;
+
+import java.util.HashSet;
+
+// THREADS DEBUG (video): keyboard-free input for the demo recording. Debug builds only.
+// 1. While the demo chat or its thread screen is on top, AndroidUtilities.showKeyboard does nothing and the field
+//    asked to show it stops showing it on tap (showSoftInputOnFocus). The window still talks to the keyboard service,
+//    so the field keeps its focus and its blinking caret (blocking the window from the IME hides the caret too).
+// 2. A broadcast types text into the focused input, one character at a time, like a typewriter:
+//    adb shell am broadcast -a com.threads.demo.TYPE -p org.telegram.messenger.beta --es text 'Hello' --ei delay_ms 45
+//    The characters go into the field's text, so the send button and the mic toggle react as for normal typing.
+public final class ThreadsDemoInput {
+
+    public static final String ACTION_TYPE = "com.threads.demo.TYPE";
+    private static final int DEFAULT_DELAY_MS = 45;
+
+    private static final HashSet<Object> blockers = new HashSet<>();
+    private static final HashSet<EditText> quietFields = new HashSet<>();
+    private static boolean receiverRegistered;
+    private static Runnable typing;
+
+    private ThreadsDemoInput() {
+    }
+
+    // THREADS DEBUG: owner = the screen asking (ChatActivity of the demo chat, its ThreadActivity). The flag stays
+    // while any owner is on top, so the order of onPause / onResume between two screens does not matter.
+    public static void blockKeyboard(Object owner, Activity activity, boolean block) {
+        if (!BuildVars.DEBUG_VERSION || activity == null) {
+            return;
+        }
+        if (block) {
+            blockers.add(owner);
+            registerReceiver();
+            View focus = activity.getCurrentFocus();
+            InputMethodManager imm = (InputMethodManager) activity.getSystemService(Context.INPUT_METHOD_SERVICE);
+            if (imm != null && focus != null) {
+                imm.hideSoftInputFromWindow(focus.getWindowToken(), 0);
+            }
+        } else {
+            blockers.remove(owner);
+            if (blockers.isEmpty()) {
+                for (EditText field : quietFields) {
+                    field.setShowSoftInputOnFocus(true);
+                }
+                quietFields.clear();
+            }
+        }
+    }
+
+    // THREADS DEBUG: called from AndroidUtilities.showKeyboard. True = don't show the keyboard for this view.
+    public static boolean suppressKeyboard(View view) {
+        if (!BuildVars.DEBUG_VERSION || blockers.isEmpty()) {
+            return false;
+        }
+        if (view instanceof EditText && quietFields.add((EditText) view)) {
+            ((EditText) view).setShowSoftInputOnFocus(false);
+        }
+        return true;
+    }
+
+    private static void registerReceiver() {
+        if (receiverRegistered) {
+            return;
+        }
+        receiverRegistered = true;
+        BroadcastReceiver receiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                String text = intent.getStringExtra("text");
+                int delay = intent.getIntExtra("delay_ms", DEFAULT_DELAY_MS);
+                AndroidUtilities.runOnUIThread(() -> type(text, Math.max(0, delay)));
+            }
+        };
+        IntentFilter filter = new IntentFilter(ACTION_TYPE);
+        Context context = ApplicationLoader.applicationContext;
+        if (Build.VERSION.SDK_INT >= 33) {
+            context.registerReceiver(receiver, filter, Context.RECEIVER_EXPORTED);
+        } else {
+            context.registerReceiver(receiver, filter);
+        }
+    }
+
+    private static void type(String text, int delayMs) {
+        if (typing != null) {
+            AndroidUtilities.cancelRunOnUIThread(typing);
+            typing = null;
+        }
+        if (text == null || text.isEmpty() || LaunchActivity.instance == null) {
+            return;
+        }
+        View focus = LaunchActivity.instance.getCurrentFocus();
+        if (!(focus instanceof EditText)) {
+            FileLog.d("THREADS demo: TYPE broadcast but no focused input");
+            return;
+        }
+        final EditText field = (EditText) focus;
+        final int[] index = {0};
+        typing = new Runnable() {
+            @Override
+            public void run() {
+                if (index[0] >= text.length()) {
+                    typing = null;
+                    return;
+                }
+                int end = text.offsetByCodePoints(index[0], 1);
+                Editable editable = field.getText();
+                int at = field.getSelectionEnd();
+                if (at < 0 || at > editable.length()) {
+                    at = editable.length();
+                }
+                editable.insert(at, text.substring(index[0], end)); // the caret moves after the new character
+                index[0] = end;
+                AndroidUtilities.runOnUIThread(this, delayMs);
+            }
+        };
+        typing.run();
+    }
+}
